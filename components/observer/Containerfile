# Deployment template. Digest is the base image pulled and isolation-tested by
# the user; final derived-image build/verification remains a separate step.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src HOME=/nonexistent
WORKDIR /app
COPY src/ /app/src/
RUN mkdir /state && chown 65532:65532 /state && chmod 0700 /state
USER 65532:65532
ENTRYPOINT ["python3", "-B", "-m", "technocore_observer"]
