# Separate image for the eleven new Multi-Room services. Lobby keeps its existing image.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS sqlite-build
RUN apt-get update && apt-get install -y --no-install-recommends gcc make libc6-dev && rm -rf /var/lib/apt/lists/*
ADD https://www.sqlite.org/2026/sqlite-autoconf-3530400.tar.gz /tmp/sqlite.tar.gz
RUN python3 -c "import hashlib, pathlib; p=pathlib.Path('/tmp/sqlite.tar.gz'); assert hashlib.sha3_256(p.read_bytes()).hexdigest() == '454e45f61c6bd75b7420e7190732dea03ce6639c63ada47bbc592f67fc340338', 'SQLite source archive hash mismatch'"
RUN tar -xzf /tmp/sqlite.tar.gz -C /tmp && cd /tmp/sqlite-autoconf-3530400 && ./configure --prefix=/opt/sqlite --disable-static && make -j2 && make install
COPY tests/sqlite_image_check.py /tmp/sqlite_image_check.py
# The pinned base Python creates a disposable database with its old SQLite.
RUN python3 /tmp/sqlite_image_check.py make /tmp/legacy.sqlite

FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/nonexistent LD_LIBRARY_PATH=/opt/sqlite/lib
COPY --from=sqlite-build /opt/sqlite/lib/ /opt/sqlite/lib/
COPY --from=sqlite-build --chown=65532:65532 /tmp/legacy.sqlite /tmp/legacy.sqlite
COPY --chown=65532:65532 tests/sqlite_image_check.py /tmp/sqlite_image_check.py
COPY src/technocore_observer/__init__.py src/technocore_observer/http.py src/technocore_observer/protocol.py /usr/local/lib/python3.12/site-packages/technocore_observer/
COPY src/technocore_full_capture/ /usr/local/lib/python3.12/site-packages/technocore_full_capture/
WORKDIR /capture
USER 65532:65532
# Fail the build before an image can be staged if Python loads an unexpected SQLite.
RUN python3 -I -B -m technocore_full_capture.sqlite_runtime --sqlite-provenance
RUN python3 -I -B /tmp/sqlite_image_check.py check /tmp/legacy.sqlite && rm /tmp/legacy.sqlite /tmp/sqlite_image_check.py
ENTRYPOINT ["python3", "-I", "-B", "-m", "technocore_full_capture.sqlite_runtime"]
