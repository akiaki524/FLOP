[Unit]
Description=FLOP Policy Signer Trusted Read-only Acquisition
Requires=flop-policy-signer-reader.socket
After=network-online.target flop-policy-signer-reader.socket
Wants=network-online.target

[Service]
Type=simple
User=flop-signer-reader
Group=flop-signer-reader
SupplementaryGroups=flop-signer-acquisition
ExecStart=/usr/local/lib/flop-policy-signer/node --disable-sigusr1 --disallow-code-generation-from-strings /usr/local/lib/flop-policy-signer/src/reader_service.mjs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
InaccessiblePaths=/var/lib/flop-policy-signer-secret /etc/flop-policy-signer /var/lib/flop-policy-signer
ReadWritePaths=/var/lib/flop-policy-signer-input
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
